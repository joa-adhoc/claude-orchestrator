#!/usr/bin/env python3
"""Start one Claude Code background session for a task: named, colored by topic, with its prompt.

  orch-new [-d DIR] [-t TOPIC] [-c COLOR] [-m MODEL] [-a AGENT] [--dry-run] NAME [PROMPT]

  NAME     "<task id> <2 to 5 words that say what the task is about>", written by the caller;
           only cut to fit 40 characters
  PROMPT   the task, sent as the user's first message (none: the session waits)
  -t       topic shared by several sessions ("78504 Codemode"): the session is named
           "<topic> › <name>" and takes the topic's color
  -c       color: red blue green yellow purple orange pink cyan (default: the topic's color, a free
           one for a new topic; without a topic, the color least used by live sessions)
  -d       working directory (default: current); Claude Code must trust it
  -m, -a   model and agent for the session

Prints one line: id, name, color. `claude attach <id>` opens the session; `claude agents` lists all.

Every session gets a name and a color. The color needs `/color` as the session's first message, so
a session starts twice: once for /color, then stopped and resumed (same id) with the prompt, which
arrives as the user's message. A new session often keeps the color only in its transcript: then
it is stopped and resumed with `/color` once more before the prompt.
"""
import argparse
import os
import sys
import time

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import orchlib as o  # noqa: E402

TOOL = "orch-new"


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-d", default=os.getcwd())
    ap.add_argument("-t", default="")
    ap.add_argument("-c", default="", choices=o.COLORS)
    ap.add_argument("-m", default="")
    ap.add_argument("-a", default="")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("name")
    ap.add_argument("prompt", nargs="?", default="")
    a = ap.parse_intermixed_args()

    cwd = os.path.abspath(os.path.expanduser(a.d))
    topic, full = o.full_name(a.name, a.t)
    color = o.pick_color(a.c, topic)

    base = ["claude", "--bg", "-n", full]
    if a.m:
        base += ["--model", a.m]
    if a.a:
        base += ["--agent", a.a]

    if a.dry_run:
        print(f"# {cwd}: {' '.join(base)} '/color {color}'  → wait idle → claude stop → "
              f"claude --bg --resume <session id> <prompt>")
        print(f"name: {full}\tcolor: {color}\tprompt: {a.prompt[:80] or '-'}")
        return

    job = o.launch(TOOL, base + [f"/color {color}"], cwd)
    session_id = o.wait_first_color(job, color, 90)
    if not session_id:
        o.die(TOOL, f"session {job} did not run /color in 90s; check `claude logs {job}`")
    if o.saved(job, "color") != color:
        job = o.apply(TOOL, job, session_id, f"/color {color}", "color", color, cwd)
    if a.prompt:
        o.stop(TOOL, job)
        o.resume(TOOL, session_id, a.prompt, cwd, job)
        time.sleep(2)
    for key, want in (("name", full), ("color", color)):
        if o.saved(job, key) != want:
            print(f"{TOOL}: {job} lost its {key}; fix it with `orch-resume {job} \"{a.name}\"` "
                  f"(same -t and -c) once it is idle", file=sys.stderr)
    print(f"{job}\t{full}\t{color}")


if __name__ == "__main__":
    main()
